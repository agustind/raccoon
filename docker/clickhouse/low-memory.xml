<!-- Settings for a 1-2 GB container (see ClickHouse "small instances" guidance). -->
<clickhouse>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_concurrent_queries>50</max_concurrent_queries>
    <!-- Background pools stay at their defaults: shrinking background_pool_size
         below number_of_free_entries_in_pool_to_execute_mutation / 2 makes the
         server refuse to start. -->
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
    <!-- System log tables grow without bound on small disks; keep them short. -->
    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <engine>ENGINE = MergeTree PARTITION BY event_date ORDER BY event_time TTL event_date + INTERVAL 3 DAY</engine>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
</clickhouse>
